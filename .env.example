# ==============================================================================
# Click Run Claw - Environment Variables
# Add these variables to your Cloudflare Pages Dashboard:
# Workers & Pages -> clickrunclaw -> Settings -> Environment variables -> Production & Preview
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EMAIL DELIVERY VIA RESEND (RECOMMENDED FOR AUTOMATED EMAIL NOTIFICATIONS)
# Free 3,000 emails/mo at https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
LEAD_TO_EMAIL="support@clickrunclaw.com"
LEAD_FROM_EMAIL="Click Run Claw <support@clickrunclaw.com>"
# Note: If your custom domain is not yet verified in Resend, the system automatically
# falls back to "Click Run Claw <onboarding@resend.dev>" so you never miss a lead.

# ------------------------------------------------------------------------------
# 2. INSTANT TELEGRAM BOT NOTIFICATIONS (RECOMMENDED FOR MOBILE PUSH ALERTS)
# 100% Free, instant ping to your phone when a client submits a brief.
# 1. Open Telegram, search @BotFather, type /newbot to create a bot & copy the API token.
# 2. Open Telegram, search @userinfobot to get your numeric user/chat ID.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ------------------------------------------------------------------------------
# 3. WEBHOOK DISPATCH (OPTIONAL: DISCORD / SLACK / N8N / MAKE)
# Automatically sends lead data as JSON to your Discord channel or automation workflow.
# ------------------------------------------------------------------------------
LEAD_WEBHOOK_URL=""
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# ------------------------------------------------------------------------------
# 4. BREVO API (OPTIONAL: ALTERNATIVE EMAIL PROVIDER)
# Free 300 emails/day at https://brevo.com
# ------------------------------------------------------------------------------
BREVO_API_KEY=""

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI API (LIVE AGENT DEMO)
# Get a free key at https://aistudio.google.com/
# If unset, the demo operates safely in high-fidelity deterministic sandbox mode.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 6. SITE METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://clickrunclaw.com"
